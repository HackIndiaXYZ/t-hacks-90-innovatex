# Copy this file to ".env" and fill in your real Groq API key.
# Get a key for free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model and port
# GROQ_MODEL=openai/gpt-oss-120b
# PORT=8000
# HOST=127.0.0.1

# Optional: search API key for the "tavily" or "serpapi" web-search provider.
# Leave unset to use the free DuckDuckGo search (no key needed).
# SEARCH_API_KEY=your_search_api_key_here
